# Copy to ".env" and adjust. Never commit the real .env file.
# This file contains NO real secrets; every value below is a placeholder or a safe default.

# --- Database ---------------------------------------------------------------
# Docker Compose builds DATABASE_URL from these three values.
POSTGRES_USER=football
POSTGRES_PASSWORD=change-me
POSTGRES_DB=football

# Running the backend WITHOUT Docker? Set DATABASE_URL yourself, for example:
#   SQLite (no install needed, fine for local development):
# DATABASE_URL=sqlite:///./dev.db
#   PostgreSQL:
# DATABASE_URL=postgresql+psycopg://football:change-me@localhost:5432/football

# --- Admin API ----------------------------------------------------------------
# Token for /api/v1/admin/* (sent as the X-Admin-Token header).
# Leave empty to disable the admin API entirely. Use a long random value otherwise.
ADMIN_API_TOKEN=

# --- Data providers -----------------------------------------------------------
# Optional. Free key from https://www.football-data.org/ gives the full fixture list.
# To use it, also add "football-data-org" to SCHEDULE_PROVIDERS.
FOOTBALL_DATA_ORG_API_KEY=
# Bookmaker columns kept from Football-Data.co.uk files.
FDUK_BOOKMAKERS=B365,PS,Avg,Max,BbAv,BbMx

# --- Scheduled job --------------------------------------------------------------
SCHEDULE_INTERVAL_MINUTES=360
SCHEDULE_COMPETITIONS=PL
SCHEDULE_PROVIDERS=football-data-uk,openfootball
SCHEDULE_RUN_EVALUATION=true

# --- Behaviour ------------------------------------------------------------------
PREDICTION_STALE_HOURS=48
DATA_STALE_HOURS=48
EVALUATION_SEASONS=3
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
LOG_JSON=true
